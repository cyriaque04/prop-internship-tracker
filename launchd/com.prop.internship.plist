<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local 3x/day scheduler for macOS.
  EDIT the two paths below to match where you keep this project, then:
    cp launchd/com.prop.internship.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.prop.internship.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prop.internship</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/ABSOLUTE/PATH/TO/prop-internship-tracker/check.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/prop-internship-tracker</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/prop-internship-tracker/state/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/prop-internship-tracker/state/launchd.log</string>
</dict>
</plist>
